{
  "name": "data-map",
  "version": "0.1.1",
  "description": "An interactive map of a dbt project's tables: zones, lineage, a status per table, its columns described.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "svelte": "./component/index.ts",
  "exports": {
    ".": {
      "types": "./component/index.ts",
      "svelte": "./component/index.ts"
    }
  },
  "files": [
    "component",
    "format"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run types && npm test && npm run build"
  },
  "peerDependencies": {
    "@lucide/svelte": "^1.57.0",
    "@xyflow/svelte": "^1.7.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.5",
    "@xyflow/svelte": "1.7.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
